# LangSmith
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING_V2=true
LANGSMITH_PROJECT=gtm-agent

# Model providers (use at least one)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Agent model selection
GTM_AGENT_MODEL=anthropic:claude-sonnet-4-6
TRIAGE_AGENT_MODEL=anthropic:claude-opus-4-6

# Deployment info (set by CI/CD)
DEPLOYMENT_VERSION=
ENVIRONMENT=production

# GitHub (for Open SWE integration)
GITHUB_TOKEN=ghp_...

# LangSmith Deployment URLs (set after deployment)
GTM_AGENT_DEPLOYMENT_URL=https://...
TRIAGE_AGENT_DEPLOYMENT_URL=https://...
OPEN_SWE_DEPLOYMENT_URL=https://...
